# Example environment variables. Copy to .env and fill with your values.

SECRET_KEY=change-me-in-production
DATABASE_URL=sqlite:///site57.db
FLASK_APP=app.py
FLASK_ENV=development

# OAuth placeholders (fill when available)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:5000/oauth/discord/callback
ROBLOX_CLIENT_ID=
ROBLOX_CLIENT_SECRET=
ROBLOX_REDIRECT_URI=http://localhost:5000/oauth/roblox/callback

# Other options
REDIS_URL=redis://localhost:6379/0
